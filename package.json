{
  "name": "aura-music-mac",
  "version": "1.0.0",
  "description": "AI-First Music Player for macOS powered by Gemini and YouTube",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "app": "npm run build && electron electron/main.cjs",
    "dist": "npm run build && electron-builder --mac --arm64",
    "dist:all": "npm run build && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.aura.music",
    "productName": "Aura",
    "copyright": "Copyright © 2026 Aura Music",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Instalar Aura",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 380,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "keywords": [
    "ai",
    "music",
    "youtube",
    "gemini",
    "electron",
    "macos"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "yt-search": "^2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
